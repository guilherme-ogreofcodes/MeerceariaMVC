@model MerceariaMVC.Models.Produto

@{
    ViewData["Title"] = "Novo Produto";
}

<div class="page-header">
    <div class="page-title">
        <h1>Cadastrar Produto</h1>
        <p>Adicione um novo item ao catálogo da mercearia.</p>
    </div>
    <a asp-action="Index" class="btn btn-secondary">
        <i class="bi bi-arrow-left"></i> Voltar
    </a>
</div>

<div class="table-card" style="padding: 2rem; max-width: 600px; margin: 0 auto;">
    <form asp-action="Create">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="form-group" style="margin-bottom: 1.2rem;">
            <label asp-for="Nome" class="form-label" style="font-weight: 600; margin-bottom: 0.4rem; display: block;">Nome do Produto</label>
            <input asp-for="Nome" class="form-control" placeholder="Ex: Arroz Tipo 1 - 5kg" />
            <span asp-validation-for="Nome" class="text-danger" style="font-size: 0.8rem; color: var(--danger);"></span>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1.5rem;">
            <div class="form-group">
                <label asp-for="Preco" class="form-label" style="font-weight: 600; margin-bottom: 0.4rem; display: block;">Preço (R$)</label>
                <input asp-for="Preco" type="number" step="0.01" class="form-control" placeholder="0,00" />
                <span asp-validation-for="Preco" class="text-danger" style="font-size: 0.8rem; color: var(--danger);"></span>
            </div>

            <div class="form-group">
                <label asp-for="Estoque" class="form-label" style="font-weight: 600; margin-bottom: 0.4rem; display: block;">Estoque Inicial</label>
                <input asp-for="Estoque" type="number" class="form-control" placeholder="0" />
                <span asp-validation-for="Estoque" class="text-danger" style="font-size: 0.8rem; color: var(--danger);"></span>
            </div>
        </div>

        <div style="display: flex; gap: 0.75rem; justify-content: flex-end; border-top: 1px solid var(--border); padding-top: 1.2rem;">
            <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
            <button type="submit" class="btn btn-primary">
                <i class="bi bi-check-lg"></i> Cadastrar Produto
            </button>
        </div>
    </form>
</div>