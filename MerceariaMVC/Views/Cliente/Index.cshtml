@model IEnumerable<MerceariaMVC.Models.Cliente>

@{
    ViewData["Title"] = "Clientes";
}

<div class="page-header">
    <div class="page-title">
        <h1>Gestão de Clientes</h1>
        <p>Consulte e mantenha atualizada a lista de clientes da mercearia.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-person-plus"></i> Novo Cliente
    </a>
</div>

<div class="toolbar">
    <div class="search-box">
        <i class="bi bi-search"></i>
        <input type="text" class="search-input" placeholder="Buscar cliente por nome ou e-mail...">
    </div>
</div>

<div class="table-card">
    <table class="custom-table">
        <thead>
            <tr>
                <th>Cliente</th>
                <th>Idade</th>
                <th>Status</th>
                <th style="text-align: right;">Ações</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        <div class="item-info">
                            <div class="item-avatar"><i class="bi bi-person"></i></div>
                            <div>
                                <strong>@item.Nome</strong>
                                <div style="font-size: 0.75rem; color: var(--text-muted);">@item.Email</div>
                            </div>
                        </div>
                    </td>
                    <td>@item.Idade anos</td>
                    <td>
                        @if (item.Ativo)
                        {
                            <span class="badge badge-success">Ativo</span>
                        }
                        else
                        {
                            <span class="badge badge-danger">Inativo</span>
                        }
                    </td>
                    <td style="text-align: right;">
                        <a asp-action="Edit" asp-route-id="@item.IdCliente" class="btn btn-secondary btn-sm" title="Editar"><i class="bi bi-pencil"></i></a>
                        <a asp-action="Details" asp-route-id="@item.IdCliente" class="btn btn-secondary btn-sm" title="Detalhes"><i class="bi bi-eye"></i></a>
                        <a asp-action="Delete" asp-route-id="@item.IdCliente" class="btn btn-secondary btn-sm" style="color: var(--danger);" title="Excluir"><i class="bi bi-trash"></i></a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>