@{
    ViewData["Title"] = "Visão Geral";
}

<div class="page-header">
    <div class="page-title">
        <h1>Painel de Controle</h1>
        <p>Bem-vindo ao MerceariaControl. Aqui está o resumo do seu negócio hoje.</p>
    </div>
    <div style="display: flex; gap: 0.5rem;">
        <a asp-controller="Produto" asp-action="Create" class="btn btn-secondary">
            <i class="bi bi-box-seam"></i> + Produto
        </a>
        <a asp-controller="Cliente" asp-action="Create" class="btn btn-primary">
            <i class="bi bi-person-plus"></i> + Cliente
        </a>
    </div>
</div>

<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1.25rem; margin-bottom: 2rem;">
    <div class="table-card" style="padding: 1.25rem; display: flex; align-items: center; gap: 1rem;">
        <div style="width: 48px; height: 48px; border-radius: 10px; background: #ecfdf5; color: var(--primary); display: flex; align-items: center; justify-content: center; font-size: 1.5rem;">
            <i class="bi bi-currency-dollar"></i>
        </div>
        <div>
            <span style="font-size: 0.8rem; color: var(--text-muted); font-weight: 600; text-transform: uppercase;">Vendas Hoje</span>
            <h3 style="font-size: 1.4rem; font-weight: 700; margin: 0;">R$ 0,00</h3>
        </div>
    </div>

    <div class="table-card" style="padding: 1.25rem; display: flex; align-items: center; gap: 1rem;">
        <div style="width: 48px; height: 48px; border-radius: 10px; background: #eff6ff; color: #3b82f6; display: flex; align-items: center; justify-content: center; font-size: 1.5rem;">
            <i class="bi bi-box-seam"></i>
        </div>
        <div>
            <span style="font-size: 0.8rem; color: var(--text-muted); font-weight: 600; text-transform: uppercase;">Produtos</span>
            <h3 style="font-size: 1.4rem; font-weight: 700; margin: 0;">Catálogo</h3>
        </div>
    </div>

    <div class="table-card" style="padding: 1.25rem; display: flex; align-items: center; gap: 1rem;">
        <div style="width: 48px; height: 48px; border-radius: 10px; background: #fef3c7; color: #d97706; display: flex; align-items: center; justify-content: center; font-size: 1.5rem;">
            <i class="bi bi-people"></i>
        </div>
        <div>
            <span style="font-size: 0.8rem; color: var(--text-muted); font-weight: 600; text-transform: uppercase;">Clientes</span>
            <h3 style="font-size: 1.4rem; font-weight: 700; margin: 0;">Gerenciar</h3>
        </div>
    </div>
</div>

<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 1.5rem;">
    <div class="table-card" style="padding: 1.5rem; display: flex; flex-direction: column; justify-content: space-between;">
        <div>
            <div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 0.75rem;">
                <i class="bi bi-boxes" style="font-size: 1.5rem; color: var(--primary);"></i>
                <h3 style="font-size: 1.1rem; font-weight: 700; margin: 0;">Gerenciar Produtos</h3>
            </div>
            <p style="font-size: 0.875rem; color: var(--text-muted); margin-bottom: 1.25rem;">
                Consulte o catálogo, cadastre novos itens e gerencie estoque.
            </p>
        </div>
        <a asp-controller="Produto" asp-action="Index" class="btn btn-secondary" style="width: 100%; justify-content: center;">
            Acessar Produtos <i class="bi bi-arrow-right"></i>
        </a>
    </div>

    <div class="table-card" style="padding: 1.5rem; display: flex; flex-direction: column; justify-content: space-between;">
        <div>
            <div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 0.75rem;">
                <i class="bi bi-person-lines-fill" style="font-size: 1.5rem; color: var(--primary);"></i>
                <h3 style="font-size: 1.1rem; font-weight: 700; margin: 0;">Gerenciar Clientes</h3>
            </div>
            <p style="font-size: 0.875rem; color: var(--text-muted); margin-bottom: 1.25rem;">
                Consulte a lista de clientes e seus dados cadastrais.
            </p>
        </div>
        <a asp-controller="Cliente" asp-action="Index" class="btn btn-secondary" style="width: 100%; justify-content: center;">
            Acessar Clientes <i class="bi bi-arrow-right"></i>
        </a>
    </div>
</div>